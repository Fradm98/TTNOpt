#!/bin/bash
#PBS -N plot_links_sectors
#PBS -q standard
#PBS -l select=1:ncpus=4:mem=70gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o pbs_plot_links_sectors.log

# Link-field plots for vacuum and both baryons (pipeline/plot_links_sectors.py).
# PDFs go to 5_Z3/figures, progress to 5_Z3/logs/plot_links_sectors[_g<G>].log.
#
# Pick a node with real free memory: pbsnodes shows requested memory, not use.
# Passing -l select on qsub overrides the line above:
#
#   qsub -l select=1:ncpus=4:mem=70gb:host=node07 pipeline/plot_links_sectors.pbs
#
# mem: 70gb is an estimate, not measured at chi=81 -- check it in qwatch.
# Link values are saved as they are computed, so a rerun after a walltime
# cut resumes where it stopped. Progress (time per link) is in the log.
#
# Smaller chi only (about 7x cheaper than chi=81; the largest saved one is used):
#
#   qsub -v "CHIS=50 27 9" pipeline/plot_links_sectors.pbs
#
# Only some g-points (default 0.1 0.7 1.5), e.g. while 0.7 is still descending:
#
#   qsub -v "CHIS=50 27 9,G=0.1 1.5" pipeline/plot_links_sectors.pbs
#
# Only some colour modes (default real arg flux net); link values already
# cached in tensors.hdf5 are reused, so redrawing is quick:
#
#   qsub -v "G=0.9 1.5,COLOR_BY=flux net" pipeline/plot_links_sectors.pbs

cd $PBS_O_WORKDIR

PYTHON="$HOME/.conda/envs/ttn/bin/python"

export OMP_NUM_THREADS=${NCPUS:-4}
export MKL_NUM_THREADS=${NCPUS:-4}
export OPENBLAS_NUM_THREADS=${NCPUS:-4}
export MPLBACKEND=Agg

mkdir -p ../5_Z3/logs

# one log per G, so jobs for different g-points can run side by side
log="../5_Z3/logs/plot_links_sectors${G:+_g${G// /_}}.log"

"$PYTHON" -u -m pipeline.plot_links_sectors ${CHIS:+--chis $CHIS} ${G:+--g $G} ${COLOR_BY:+--color-by $COLOR_BY} >> "$log" 2>&1
