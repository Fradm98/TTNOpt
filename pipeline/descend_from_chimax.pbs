#!/bin/bash
#PBS -N descend_from_chimax
#PBS -q standard
#PBS -l select=1:ncpus=8:mem=100gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o pbs_descend_from_chimax.log

# Refresh chi=50/27/9 for g-points whose chi=81 never converged but is
# being used anyway (provisional basic.csv via make_provisional_basic_csv.pbs):
# their lower-chi basic.csv/tensors are still the cheap ASCEND-phase ones.
# This truncates the existing chi=81 tensor at the SAME g down through
# DESCEND_CHIS (g_descend_existing.py), overwriting run_chi-{50,27,9}/
# basic.csv, convergence.csv and their tensors.hdf5 entries. Converges as
# far as the (unconverged) chi=81 state allows -- each stage stops at its
# sweep budget if the thresholds aren't reached; check convergence.csv.
#
# One g per job (pass G via -v). To find and submit every affected point:
#
#   G_LIST=$($HOME/.conda/envs/ttn/bin/python -m pipeline.g_descend_existing --list-stale \
#       --source-chi 81 --descend-chis 50 27 9 --lx 5 --ly 9 --shape hexagon \
#       --drive-path /home/fradm/projects/5_Z3 | tail -1)
#   for g in $G_LIST; do qsub -o pbs_descend_g$g.log -v G=$g pipeline/descend_from_chimax.pbs; done
#
# --list-stale flags a g when any descend chi's basic.csv is missing or
# OLDER than chi=81's, i.e. was never descended from the current chi=81 state.
#
# Charge sector: vacuum by default. Otherwise pass BOUND_STATE plus R, or
# explicit CHARGESX/CHARGESY, matching the original g_sweep run (and add the
# same flags, e.g. --bound-state baryon --r 2, to the --list-stale call above):
#
#   qsub -o pbs_descend_baryon_R2_g-1.500.log -v G=-1.500,BOUND_STATE=baryon,R=2 pipeline/descend_from_chimax.pbs
#   qsub -o pbs_descend_baryon_custom1_g-1.500.log \
#       -v "G=-1.500,BOUND_STATE=baryon,CHARGESX=-1 -2 3,CHARGESY=2 7 3" pipeline/descend_from_chimax.pbs
#
# G is the actual, negative coupling. The chi=81 tensor must already exist in
# tensors.hdf5: if it doesn't, the run falls back to a random start.
#
# mem: the job works at chi<=50, but the first sweeps still touch the
# loaded chi=81 tensors. 100gb is below the chi=81 production peak (~135gb)
# and not measured for this descent -- check the real peak in qwatch.
#
# walltime: a Mac-log chi=50 sweep took 0.5h on average, 1.5h at most, and
# descents usually converged in under 10 sweeps.
#
# Resuming a cut descent: the first descend chi (50) is saved after every
# sweep, so a descent cut during the chi=50 stage restarts from that tensor,
# not from chi=81, with a fresh sweep budget for chi=50 (each stage gets one):
#
#   qsub -o pbs_descend_resume_g-0.900.log \
#       -v "G=-0.900,BOUND_STATE=baryon,CHARGESX=-1 -2 3,CHARGESY=2 7 3,SOURCE_CHI=50,DESCEND_CHIS=50 27 9" \
#       pipeline/descend_from_chimax.pbs
#
# Only the chi=50 stage has this: a cut during chi=27 or chi=9 resumes from
# chi=50's end-of-stage tensor (SOURCE_CHI=50,DESCEND_CHIS=27 9,SWEEPS_DESCEND=20 10).

cd $PBS_O_WORKDIR

if [ -z "$G" ]; then
    echo "ERROR: pass the g-value with qsub -v G=<g> (see header)" >&2
    exit 1
fi

PYTHON="$HOME/.conda/envs/ttn/bin/python"
DRIVE_PATH="/home/fradm/projects/5_Z3"
LX=5
LY=9
SHAPE=hexagon
SOURCE_CHI=${SOURCE_CHI:-81}
DESCEND_CHIS="${DESCEND_CHIS:-50 27 9}"
SWEEPS_DESCEND="${SWEEPS_DESCEND:-25 20 10}"    # same tapered budget as the production batches
ENERGY_CONVERGENCE_THRESHOLD=1e-10
ENTANGLEMENT_CONVERGENCE_THRESHOLD=1e-8   # matches g_sweep_presto_batch_generator.sh

export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8
export OPENBLAS_NUM_THREADS=8

CHARGE_ARGS=""
TAG=vacuum
if [ -n "$BOUND_STATE" ]; then
    CHARGE_ARGS="--bound-state $BOUND_STATE --r ${R:-1}"
    TAG="${BOUND_STATE}_R${R:-1}"
    if [ -n "$CHARGESX" ]; then
        CHARGE_ARGS="$CHARGE_ARGS --chargesx $CHARGESX --chargesy $CHARGESY"
        TAG="${BOUND_STATE}_x${CHARGESX// /_}_y${CHARGESY// /_}"
    fi
fi

mkdir -p ../5_Z3/logs
log="../5_Z3/logs/descend_from_chi${SOURCE_CHI}_${TAG}_g${G}.log"
echo "g=$G: chi=$SOURCE_CHI -> $DESCEND_CHIS on $(hostname) at $(date), log: $log"

"$PYTHON" -u -m pipeline.g_descend_existing \
    --g-values "$G" \
    --source-chi "$SOURCE_CHI" --descend-chis $DESCEND_CHIS --sweeps-descend $SWEEPS_DESCEND \
    --energy-convergence-threshold "$ENERGY_CONVERGENCE_THRESHOLD" \
    --entanglement-convergence-threshold "$ENTANGLEMENT_CONVERGENCE_THRESHOLD" \
    --lx "$LX" --ly "$LY" --shape "$SHAPE" \
    --patched $CHARGE_ARGS \
    --drive-path "$DRIVE_PATH" \
    > "$log" 2>&1

echo "g=$G finished at $(date)"
