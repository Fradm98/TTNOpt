#!/bin/bash
#PBS -N eigensolver_scan
#PBS -l select=1:ncpus=16:mem=350gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o pbs_eigensolver_scan.log

# If your scheduler rejects the combined "select=...:mem=" chunk syntax
# above, split it instead:
#   #PBS -l select=1:ncpus=16
#   #PBS -l mem=350gb

cd $PBS_O_WORKDIR

# --- environment -----------------------------------------------------------
PYTHON="$HOME/.conda/envs/ttn/bin/python"

export OMP_NUM_THREADS=16
export MKL_NUM_THREADS=16
export OPENBLAS_NUM_THREADS=16

echo "Job started on $(hostname) at $(date)"

# Requires g_chi_scan_diagnostic.py to have already run and left a
# checkpoint at (g=-2.0, chi=100) in ../5_Z3/logs/g_chi_scan_checkpoint.hdf5
"$PYTHON" -u diagnostics/g_fixed_chi_eigensolver_scan.py > ../5_Z3/logs/g_fixed_chi_eigensolver_scan_run.log 2>&1

echo "Job finished at $(date)"
