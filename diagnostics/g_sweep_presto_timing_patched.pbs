#!/bin/bash
#PBS -N g_sweep_timing_patched
#PBS -l select=1:ncpus=16:mem=350gb
#PBS -l walltime=4:00:00
#PBS -j oe
#PBS -o pbs_g_sweep_timing_patched.log

# Patched-vs-unpatched SPEED comparison, other half -- see
# g_sweep_presto_timing_unpatched.pbs for the full explanation. Submit
# both together so they run concurrently on separate PBS allocations.

cd $PBS_O_WORKDIR

PYTHON="$HOME/.conda/envs/ttn/bin/python"
DRIVE_PATH="/home/fradm/projects/5_Z3_timing_patched"

export OMP_NUM_THREADS=16
export MKL_NUM_THREADS=16
export OPENBLAS_NUM_THREADS=16

mkdir -p "$DRIVE_PATH/logs"

echo "Job started on $(hostname) at $(date)"

time "$PYTHON" -u -m pipeline.g_sweep \
    --lx 5 --ly 5 --shape parallelogram \
    --g-min 1.5 --g-max 1.5 --n-g 1 \
    --chis 9 18 27 \
    --sweeps-ascend 3 --sweeps-converge 10 --sweeps-descend 3 \
    --patched \
    --drive-path "$DRIVE_PATH" \
    > "$DRIVE_PATH/logs/g_sweep_run.log" 2>&1

echo "Job finished at $(date)"
